# Copy this file to .env.local and fill in real values before deploying.
# .env.local is gitignored — never commit real keys. This file (.env.example)
# IS meant to be committed since it contains no secrets, just variable names.

# ---------------------------------------------------------------------------
# Resend (https://resend.com) — powers real email delivery for
# app/api/contact/route.ts and app/api/book-meeting/route.ts via lib/email.ts.
# Get your key from https://resend.com/api-keys
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# The inbox that should receive contact form + meeting request notifications.
# Falls back to siteConfig.email if unset.
CONTACT_NOTIFICATION_EMAIL=hello@pixelnox.com

# ---------------------------------------------------------------------------
# NOTE on the "from" address: lib/email.ts currently sends from Resend's
# shared test address (onboarding@resend.dev), which works immediately with
# any API key but can only deliver to the email address on your Resend
# account. Once you verify your own domain in the Resend dashboard
# (https://resend.com/domains), update FROM_ADDRESS in lib/email.ts to
# something like "Pixel Nox <notifications@pixelnox.com>" so you can send
# to any real inbox, including CONTACT_NOTIFICATION_EMAIL above.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Site URL — must match data/siteConfig.ts `url` field once you have a real
# domain. Used by sitemap.ts, robots.ts, and metadata (Open Graph, canonical).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://pixelnox.com
